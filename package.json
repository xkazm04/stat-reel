{
  "name": "statreel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @statreel/server --filter @statreel/studio run \"/^(dev|worker)$/\"",
    "worker": "pnpm --filter @statreel/server worker",
    "build": "pnpm -r build",
    "start": "pnpm --parallel --filter @statreel/server run \"/^(start|worker)$/\"",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "check": "node scripts/check.mjs",
    "e2e": "cross-env LLM_MODE=replay AUDIO_MODE=replay PUBLISH_MODE=dry GEN_MODE=fake playwright test",
    "e2e:live": "cross-env LLM_MODE=live AUDIO_MODE=live PUBLISH_MODE=dry LLM_RECORD=1 AUDIO_RECORD=1 E2E_LIVE=1 playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.59.0",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
